PORT=8080
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=https://msorsor1956.github.io

# Set a long random value before using the private admin endpoints.
ADMIN_API_KEY=

# Local default: ./.data. On Railway, mount a persistent volume at /data
# and set DATA_DIR=/data.
DATA_DIR=.data

# Stripe server credentials. Prefer a restricted key (rk_) with only the
# permissions required to read Prices and create Checkout Sessions.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# One active, one-time Stripe Price ID for each server-owned catalog item.
STRIPE_PRICE_TRAVEL_SLEEVE=
STRIPE_PRICE_DAILY_RITUAL=
STRIPE_PRICE_FAMILY_RESERVE=

# Public origin used in Stripe success/cancel redirects.
PUBLIC_BASE_URL=http://localhost:8080

# Transactional employee invitations through Resend. Verify the sender domain
# first; use a named sender such as SEVEN ROOTS <staff@updates.example.com>.
RESEND_API_KEY=
EMAIL_FROM=
# Optional address for employee replies.
EMAIL_REPLY_TO=

# Private work files (SOW, documents, photos, and video) are stored under
# DATA_DIR/work-files. The per-file limit defaults to 50 MB and is capped at 100 MB.
MAX_TASK_FILE_MB=50

# Contact shown to authenticated employees in the private directory.
ADMIN_CONTACT_NAME=SEVEN ROOTS Owner Admin
ADMIN_CONTACT_EMAIL=
ADMIN_CONTACT_PHONE=
ADMIN_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API task notifications. Create and approve a template with
# three body variables: employee name, task title, and task status.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TASK_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ISO 3166-1 alpha-2 destinations accepted for this physical product.
STRIPE_SHIPPING_COUNTRIES=US

# Optional comma-separated Stripe Shipping Rate IDs. Leave empty only when
# delivery is intentionally included at no additional Checkout charge.
STRIPE_SHIPPING_RATE_IDS=

# Zoho Inventory bridge. Keep disabled while validating the OAuth connection,
# Liberia/U.S. locations, the online customer, and exact storefront SKU maps.
ZOHO_INVENTORY_ENABLED=false
ZOHO_INVENTORY_ORGANIZATION_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_LIBERIA_LOCATION_ID=
ZOHO_US_LOCATION_ID=
ZOHO_ONLINE_CUSTOMER_ID=

# Change both only when the Zoho account belongs to another data center.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com/inventory/v1
