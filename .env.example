PORT=8080
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=https://msorsor1956.github.io

# Set a long random value before using the private admin endpoints.
ADMIN_API_KEY=

# Local default: ./.data. On Railway, mount a persistent volume at /data
# and set DATA_DIR=/data.
DATA_DIR=.data
